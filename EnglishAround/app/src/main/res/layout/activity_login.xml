<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/loginRoot" android:layout_width="match_parent"
    android:layout_height="match_parent" android:fillViewport="true"
    android:background="@color/ea_background" android:clipToPadding="false">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:paddingStart="24dp" android:paddingEnd="24dp"
        android:paddingBottom="24dp">

        <ImageView android:layout_width="64dp" android:layout_height="64dp"
            android:layout_gravity="center_horizontal" android:layout_marginTop="64dp"
            android:background="@drawable/ea_logo_background" android:padding="14dp"
            android:src="@drawable/ea_ic_book" android:contentDescription="Логотип English Around"/>

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="16dp" android:gravity="center" android:text="English Around"
            android:textSize="20sp" android:textStyle="bold" android:textColor="@color/ea_text"/>

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="48dp" android:text="Добро пожаловать"
            android:textSize="26sp" android:textStyle="bold" android:textColor="@color/ea_text"/>

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:text="Войдите, чтобы продолжить обучение"
            android:textSize="14sp" android:textColor="@color/ea_muted"/>

        <TextView android:id="@+id/errorText"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:textColor="@color/ea_error"
            android:textSize="12sp" android:accessibilityLiveRegion="polite"
            android:visibility="gone" tools:visibility="visible"
            tools:text="Неверная электронная почта или пароль"/>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/emailLayout" style="@style/EaField"
            android:hint="Электронная почта" app:startIconDrawable="@drawable/ea_ic_email">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/emailInput" style="@style/EaInput"
                android:inputType="textEmailAddress" android:autofillHints="emailAddress" android:imeOptions="actionNext"/>

        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/passwordLayout" style="@style/EaField"
            android:hint="Пароль" app:startIconDrawable="@drawable/ea_ic_lock"
            app:endIconMode="password_toggle">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/passwordInput" style="@style/EaInput"
                android:inputType="textPassword" android:autofillHints="password" android:saveEnabled="false" android:imeOptions="actionDone"/>

        </com.google.android.material.textfield.TextInputLayout>

        <TextView android:id="@+id/resetLink" style="@style/EaLink"
            android:layout_gravity="end" android:text="Забыли пароль?"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/loginButton" style="@style/EaButton"
            android:layout_marginTop="8dp" android:text="Войти"/>

        <ProgressBar android:id="@+id/progress"
            android:layout_width="28dp" android:layout_height="28dp"
            android:layout_gravity="center_horizontal" android:layout_marginTop="12dp"
            android:indeterminateTint="@color/ea_primary" android:visibility="gone"
            android:contentDescription="Выполняется запрос"/>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center" android:layout_marginTop="48dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Нет аккаунта?" android:textSize="13sp" android:textColor="@color/ea_muted"/>
            <TextView android:id="@+id/registerLink" style="@style/EaLink"
                android:text="Зарегистрироваться" android:textSize="13sp"/>
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical"
            android:layout_marginTop="20dp">
            <View android:layout_width="0dp" android:layout_height="1dp"
                android:layout_weight="1" android:background="#E5E5E5"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="ИЛИ ЧЕРЕЗ" android:textSize="10sp" android:textColor="@color/ea_muted"
                android:paddingStart="16dp" android:paddingEnd="16dp"/>
            <View android:layout_width="0dp" android:layout_height="1dp"
                android:layout_weight="1" android:background="#E5E5E5"/>
        </LinearLayout>

    </LinearLayout>
</ScrollView>
