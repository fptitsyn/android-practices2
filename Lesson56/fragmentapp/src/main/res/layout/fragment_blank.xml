<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="16dp">
    <TextView android:id="@+id/numberText" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:textSize="22sp" android:textStyle="bold" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="12dp" android:text="@string/todo_hint" android:textSize="16sp" />
    <ListView android:id="@+id/todoList" android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:choiceMode="multipleChoice" android:layout_marginTop="8dp" />
</LinearLayout>
