<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="horizontal" android:gravity="center_vertical" android:padding="12dp">

    <ImageView android:id="@+id/imageViewTodo" android:layout_width="96dp" android:layout_height="96dp"
        android:layout_marginEnd="12dp" android:scaleType="fitCenter" android:importantForAccessibility="no" />

    <TextView android:id="@+id/textViewTitle" android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1" android:textSize="16sp" />

    <CheckBox android:id="@+id/checkBoxCompleted" android:layout_width="48dp" android:layout_height="48dp" />
</LinearLayout>
