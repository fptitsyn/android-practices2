diff --git a/Navigation/navigationdrawer/src/main/res/layout/fragment_about.xml b/Navigation/navigationdrawer/src/main/res/layout/fragment_about.xml
new file mode 100644
index 0000000..ac60dde
--- /dev/null
+++ b/Navigation/navigationdrawer/src/main/res/layout/fragment_about.xml
@@ -0,0 +1,20 @@
+<?xml version="1.0" encoding="utf-8"?>
+<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
+    xmlns:app="http://schemas.android.com/apk/res-auto"
+    android:layout_width="match_parent" android:layout_height="match_parent"
+    android:fillViewport="true" android:background="@color/nav_background">
+    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
+        android:orientation="vertical" android:padding="24dp">
+        <ImageView android:layout_width="56dp" android:layout_height="56dp"
+            android:src="@drawable/ic_info" app:tint="@color/nav_primary"
+            android:importantForAccessibility="no" />
+        <TextView android:id="@+id/titleText" android:layout_width="match_parent"
+            android:layout_height="wrap_content" android:layout_marginTop="20dp"
+            android:text="@string/about_title" android:textSize="26sp" android:textStyle="bold" />
+        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
+            android:layout_marginTop="8dp" android:text="@string/about_subtitle" android:textSize="16sp" />
+        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
+            android:layout_marginTop="24dp" android:padding="16dp" android:background="@color/nav_surface"
+            android:text="@string/about_body" android:textSize="17sp" android:lineSpacingExtra="4dp" />
+    </LinearLayout>
+</ScrollView>
